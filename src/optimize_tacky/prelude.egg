(datatype Const
    (Integer i64)
    (Double f64)
)

(datatype Val
    (Constant Const :cost 0)
    (Var String :cost 8)
    (Static String)
)

(datatype BinaryOp
    (Add)
    (Subtract)
    (Multiply)
    (Divide)
    (Remainder)
    (Equal)
    (NotEqual)
    (LessThan)
    (LessOrEqual)
    (GreaterThan)
    (GreaterOrEqual)
)

(datatype UnaryOp
    (Negate)
    (Complement)
    (Not)
)

(datatype OptionVal
    (Some Val)
    (None)
)

(sort VVec (Vec Val))

(datatype PhiVal
    (P Val i64)
)

(sort PVec (Vec PhiVal))

(datatype Instruction
    (Nop)
    (Return OptionVal)
    (Cast Val Val)
    (Unary UnaryOp Val Val)
    (Binary BinaryOp Val Val Val)
    (Copy Val Val)
    (GetAggress Val Val)
    (Load Val Val)
    (Store Val Val)
    (Jump String)
    (JumpIfZero Val String)
    (JumpIfNonZero Val String)
    (Label String)
    (FunCall
        Val
        VVec
        Val
    )
    (AddPtr
        Val
        Val
        i64
        Val
    )
    (CopyToOffset
        Val Val i64
    )
    (CopyFromOffset
        Val i64 Val
    )

    (Phi Val PVec)
)

(sort VecInstructionBase (Vec Instruction))
(datatype VecInstruction (VI VecInstructionBase))

(datatype NodeId
    (Start)
    (Block i64)
    (Exit)
)

(datatype Node
    (N i64 VecInstruction)
)

; Assign Indices to Instructions
(datatype ValidIndexBase
    (ValidIndex VecInstruction i64)
)
(rule
    ((VI v))
    ((ValidIndex (VI v) 0))
)
(rule
    ((ValidIndex (VI v) i) (< (+ i 1) (vec-length v)))
    ((ValidIndex (VI v) (+ i 1)))
)

; Constant folding for addition
(rewrite
    (Binary (Add) x y dst)
    (Binary (Add) y x dst)
)
(rewrite
    (Binary (Add) x (Constant (Integer 0)) dst)
    (Copy x dst)
)
(rewrite
    (Binary (Add) (Constant (Integer x)) (Constant (Integer y)) dst)
    (Copy (Constant (Integer (+ x y))) dst)
)

; Copy propagation
(rule
    ((= i (Copy src (Var x))))
    ((union i (Nop)) (union src (Var x)))
)

; remove nop
(rule
    ((ValidIndex (VI v) i) (= (vec-get v i) (Nop)))
    ((union (VI v) (VI (vec-remove v i))))
)

(rule
    ((Binary op l r dst1) (Binary op l r dst2))
    ((union dst1 dst2))
)

; remove common sub-expression
(rule
    ((ValidIndex (VI v) i) (ValidIndex (VI v) k) (= (vec-get v i) (Binary op l r dst)) (= (vec-get v k) (Binary op l r dst)) (< i k))
    ((union (VI v) (VI (vec-set v k (Nop)))))
)

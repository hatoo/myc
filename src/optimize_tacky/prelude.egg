(datatype Const
    (Integer i64)
    (Double f64)
)

(datatype Val
    (Constant Const :cost 0)
    (Var String :cost 8)
    (Static String)
)

(datatype BinaryOp
    (Add)
    (Subtract)
    (Multiply)
    (Divide)
    (Remainder)
    (Equal)
    (NotEqual)
    (LessThan)
    (LessOrEqual)
    (GreaterThan)
    (GreaterOrEqual)
)

(datatype UnaryOp
    (Negate)
    (Complement)
    (Not)
)

(datatype OptionVal
    (Some Val)
    (None)
)

(sort VVec (Vec Val))

(datatype PhiVal
    (P Val i64)
)

(sort PVec (Vec PhiVal))

(datatype Instruction
    (Nop)
    (Return OptionVal)
    (Cast Val Val)
    (Unary UnaryOp Val Val)
    (Binary BinaryOp Val Val Val)
    (Copy Val Val)
    (GetAggress Val Val)
    (Load Val Val)
    (Store Val Val)
    (Jump String)
    (JumpIfZero Val String)
    (JumpIfNonZero Val String)
    (Label String)
    (FunCall
        Val
        VVec
        Val
    )
    (AddPtr
        Val
        Val
        i64
        Val
    )
    (CopyToOffset
        Val Val i64
    )
    (CopyFromOffset
        Val i64 Val
    )

    (Phi Val PVec)
)

(sort VecInstructionSort (Vec Instruction))
(datatype BasicBlockSort (Block VecInstructionSort))

(datatype NodeId
    (Start)
    (BlockId i64)
    (Exit)
)

(relation Node (i64 BasicBlockSort))

; Assign Indices to Instructions
(relation ValidIndex (BasicBlockSort i64))
(rule
    ((Block v))
    ((ValidIndex (Block v) 0))
)
(rule
    ((ValidIndex (Block v) i) (< (+ i 1) (vec-length v)))
    ((ValidIndex (Block v) (+ i 1)))
)

; Constant folding for addition
(rewrite
    (Binary (Add) x y dst)
    (Binary (Add) y x dst)
)
(rewrite
    (Binary (Add) x (Constant (Integer 0)) dst)
    (Copy x dst)
)
(rewrite
    (Binary (Add) (Constant (Integer x)) (Constant (Integer y)) dst)
    (Copy (Constant (Integer (+ x y))) dst)
)

; Constant folding for jumps
(rewrite
    (JumpIfZero (Constant (Integer 0)) label)
    (Jump label)
)
(rewrite
    (JumpIfZero (Constant (Integer x)) label)
    (Nop)
    :when ((!= x 0))
)
(rewrite
    (JumpIfNonZero (Constant (Integer 0)) label)
    (Nop)
)
(rewrite
    (JumpIfNonZero (Constant (Integer x)) label)
    (Jump label)
    :when ((!= x 0))
)

; Copy propagation
(rule
    ((= i (Copy src (Var x))))
    ((union i (Nop)) (union src (Var x)))
)

; remove nop
(rule
    ((ValidIndex (Block v) i) (= (vec-get v i) (Nop)))
    ((union (Block v) (Block (vec-remove v i))))
)

; remove common sub-expression
(rule
    ((ValidIndex (Block v) i) (ValidIndex (Block v) k) (= (vec-get v i) (Binary op l r dst1)) (= (vec-get v k) (Binary op l r dst2)))
    ((union dst1 dst2))
)
(rule
    ((ValidIndex (Block v) i) (ValidIndex (Block v) k) (= (vec-get v i) (Binary op l r dst)) (= (vec-get v k) (Binary op l r dst)) (< i k))
    ((union (Block v) (Block (vec-set v k (Nop)))))
)
